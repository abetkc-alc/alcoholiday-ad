# .env の見本（名前だけ。値は書かない）。このファイルは GitHub に送ってよい
# 使い方：このファイルを .env という名前でコピーし、= のあとに本物の値を貼る
# 本物の値が入った .env は GitHub に送らない（.gitignore 済み）

# Claude API（Anthropic）のキー
ANTHROPIC_API_KEY=

# Higgsfield（動画生成）
HF_KEY=

# BAR広告：Google Apps Script のウェブアプリの URL
BAR_API_URL=

# BAR広告：Apps Script の setup() で出た API_KEY
BAR_API_KEY=

# Google の読み上げ（ナレーション）
GOOGLE_TTS_KEY=

# ChatGPT（OpenAI）：10_しゃべるキャラ で使う
OPENAI_API_KEY=

# Gemini（Google）：動画の分析（08_AI部署/data/gemini.py）。Google AI Studio で作る
GEMINI_API_KEY=

# Gemini の種類（空なら gemini-flash-latest）
GEMINI_MODEL=
